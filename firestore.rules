rules_version = '2';

// Elderly Support League — Firestore Security Rules
//
// DEPLOY MANUALLY, never from an automated tool:
//   firebase deploy --only firestore:rules
//
// Changes from the previous version:
//   - players write is now admin-only. It was `request.auth != null`, meaning any
//     signed-in account could delete the collection. Harmless while it was just
//     autocomplete strings; unacceptable once players_v2 is the canonical registry
//     that every statistic depends on.
//   - match create is now an explicit email allowlist rather than "any signed-in
//     user". Add editors to the list deliberately.
//   - added basic shape validation so a malformed write can't corrupt the render.
//
// ALSO CHECK: Firebase Console > Authentication > Settings > User actions.
// If self-signup is enabled, anyone can create an account in seconds. Disable it.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // TWO TIERS.
    //
    // isOwner()     — Can. Holds the Gemini key (his Blaze billing), the roast
    //                 safety settings, and every irreversible edit.
    // isOrganizer() — owner + trusted organizers. Everything needed to run the
    //                 league week to week: enter and edit matches, add players
    //                 and venues, schedule fixtures, record results, publish
    //                 roasts.
    //
    // The split is about blast radius, not trust. An organizer can do all the
    // day-to-day work; only the owner can rotate the API key, reopen a roast
    // opt-out, or destroy history that has no undo.
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == 'can.ozturk1907@gmail.com';
    }

    // Add trusted organizers here. Keep it explicit — there is no role system,
    // this list IS the permission model.
    function isOrganizer() {
      return isSignedIn() && request.auth.token.email in [
        'can.ozturk1907@gmail.com',
        'elderly.group.futsal@gmail.com'
      ];
    }

    function validMatch() {
      let d = request.resource.data;
      return d.keys().hasAll(['date', 'type', 'teams'])
        && d.date is timestamp
        && d.type in ['Standard', 'Tournament']
        && d.teams is list
        && d.teams.size() >= 2
        && d.teams.size() <= 3;
    }

    /* ========== MATCHES (legacy, retired) ========== */
    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;   // retired — v2 is canonical
    }

    /* ========== MATCHES V2 (canonical, Stage B+) ========== */
    match /matches_v2/{matchId} {
      allow read: if true;
      allow create: if isOrganizer() && validMatch();
      allow update: if isOrganizer() && validMatch();
      allow delete: if isOwner();   // hard delete, no archive — owner only
    }

    /* ========== PLAYERS (legacy autocomplete, retired) ========== */
    match /players/{playerId} {
      allow read: if true;
      allow write: if false;   // retired — v2 is canonical
    }

    /* ========== PLAYERS V2 (canonical registry, Stage B) ========== */
    // Read-only to the world, admin-only to write. This collection is the source
    // of truth for player identity — corrupting it corrupts all history.
    match /players_v2/{playerId} {
      allow read: if true;
      allow create: if isOrganizer();          // a new joiner mid-entry
      allow update, delete: if isOwner();      // a rename rewrites every stat
    }

    /* ========== LOCATIONS ========== */
    match /locations/{locId} {
      allow read: if true;
      allow write: if isOrganizer();
    }

    /* ========== FIXTURES & ROASTS (Item 42) ========== */
    // Rules are not filters. A listener that does not carry a query constraint
    // matching the condition below is rejected outright — it is not silently
    // narrowed to the readable documents. That is what broke the public Roast and
    // Next Game cards: app.js listened unconstrained. It now listens with
    // .where('status','==','scheduled') / .where('status','==','published') when
    // signed out, and unconstrained only as admin.
    //
    // Verified in the rules emulator: an inequality condition here
    // (status != 'draft') DOES admit the equality query, so the previous wording
    // works too. These conditions mirror the client queries exactly anyway —
    // that is the intent, not a workaround.
    match /fixtures/{fixtureId} {
      allow read: if isOrganizer() || (resource != null && resource.data.status == 'scheduled');
      allow create, update: if isOrganizer();
      allow delete: if isOwner();
    }

    match /roasts/{roastId} {
      allow read: if isOrganizer() || (resource != null && resource.data.status == 'published');
      allow create, update: if isOrganizer();
      allow delete: if isOwner();   // no undo — owner only
    }

    /* ========== CONFIG ========== */
    // The API key itself (config/gemini) deliberately has NO rule, so it falls to
    // the default deny below and is unreadable by every client including the
    // admin. Cloud Functions reach it through the Admin SDK, which bypasses rules.
    //
    // config/gemini_meta holds only non-secret metadata (last 4 characters,
    // updatedAt, selected model). openGeminiSettings() reads it directly, and
    // without this rule that read was denied and swallowed by a try/catch — the
    // settings modal showed "Not configured" even with a key installed.
    match /config/gemini_meta {
      allow read: if isOwner();   // tied to the owner's billing
      allow write: if false;   // written by Cloud Functions via the Admin SDK
    }

    // The opt-out list is a promise to a person that they will not be roasted.
    // It should not be reversible by whoever happens to be signed in.
    match /config/roast_settings {
      allow read, write: if isOwner();
    }

    /* ========== DEFAULT DENY ========== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
